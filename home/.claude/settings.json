{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "statusLine": {
    "type": "command",
    "command": "node ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/hud/omc-hud.mjs"
  },
  "enabledPlugins": {
    "auth0@claude-plugins-official": false,
    "superpowers@claude-plugins-official": false,
    "code-review@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "code-simplifier@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false,
    "gitlab@claude-plugins-official": true,
    "kotlin-lsp@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": false,
    "oh-my-claudecode@omc": true,
    "figma@claude-plugins-official": true,
    "ksafe@ksafe": true
  },
  "extraKnownMarketplaces": {
    "omc": {
      "source": {
        "source": "github",
        "repo": "Yeachan-Heo/oh-my-claudecode"
      }
    },
    "ksafe": {
      "source": {
        "source": "github",
        "repo": "ioannisa/KSafe"
      }
    }
  },
  "theme": "auto",
  "agentPushNotifEnabled": true
}
