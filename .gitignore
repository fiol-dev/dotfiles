# Never track live secrets, even by accident.
**/AmneziaVPN.conf
**/AmneziaVPN.ORG/
*.pem
*.key
id_*
!id_*.pub

# ~/.claude/ is mostly runtime/session state and credentials — only
# settings.json and statusline-command.sh are meant to be tracked here.
home/.claude/.credentials.json
home/.claude/history.jsonl
home/.claude/sessions/
home/.claude/projects/
home/.claude/session-env/

# Never track the animated wallpaper videos — third-party, ~380MB, never
# added by export.sh (it only ever copies the flat file list), but this
# catches an accidental manual `git add` too.
home/Pictures/Wallpapers/Animated/

# Editor/OS noise
.DS_Store
*.swp
.omc/
localdir
